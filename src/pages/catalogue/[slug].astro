---
import {
  ArrowLeft,
  BookOpen,
  Clock,
  GraduationCap,
  MonitorPlay,
  Settings,
  Target,
  Users,
  Wrench,
} from "lucide-react";

import { Button } from "@/components/ui/button";
import { SITE_DESCRIPTION } from "@/consts";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { getAllFormations, getFormation } from "@/lib/get-formations";

export async function getStaticPaths() {
  return getAllFormations().map((formation) => ({
    params: { slug: formation.slug },
    props: { formationSlug: formation.slug },
  }));
}

const { formationSlug } = Astro.props;
const formation = formationSlug ? getFormation(formationSlug) : null;

if (!formation) {
  return Astro.redirect("/404");
}

const tabs = [
  { label: "Description", href: "#description", icon: "BookOpen" },
  { label: "Objectifs", href: "#objectifs", icon: "Target" },
  { label: "Programme", href: "#programme", icon: "GraduationCap" },
  { label: "Public cible", href: "#public", icon: "Users" },
  { label: "Modalités", href: "#modalites", icon: "Settings" },
  { label: "Prérequis", href: "#prerequis", icon: "Wrench" },
];
---

<DefaultLayout
  title={formation.title}
  description={formation.description ?? SITE_DESCRIPTION}
>
  <!-- ── Hero ── -->
  <section class="border-b border-border/60 bg-white">
    <div class="container py-10 sm:py-14">
      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground transition-colors">Accueil</a>
        <span>/</span>
        <a href="/catalogue" class="hover:text-foreground transition-colors"
          >Catalogue</a
        >
        <span>/</span>
        <span
          class="text-foreground font-medium truncate max-w-[200px] sm:max-w-none"
          >{formation.title}</span
        >
      </nav>

      <div class="max-w-4xl">
        {
          formation.subtitle ? (
            <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-muted px-3 py-1 text-sm font-medium text-foreground/75">
              <span class="inline-flex size-2 rounded-full bg-[#FF9800]" />
              {formation.subtitle}
            </div>
          ) : null
        }

        <h1
          class="font-display text-3xl font-semibold leading-[1.06] sm:text-4xl lg:text-[2.75rem]"
        >
          {formation.title}
        </h1>
        <p
          class="text-muted-foreground mt-4 max-w-2xl text-base leading-8 sm:text-lg"
        >
          {formation.description}
        </p>

        <div class="mt-7 grid gap-3 sm:grid-cols-3">
          <div
            class="rounded-2xl border border-primary/12 bg-primary/5 px-4 py-3"
          >
            <p
              class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground"
            >
              Durée
            </p>
            <div
              class="mt-2 flex items-center gap-2 text-sm font-medium text-foreground"
            >
              <Clock className="size-4 text-primary" />
              {formation.duration}
            </div>
          </div>
          <div
            class="rounded-2xl border border-primary/12 bg-primary/5 px-4 py-3"
          >
            <p
              class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground"
            >
              Format
            </p>
            <div
              class="mt-2 flex items-center gap-2 text-sm font-medium text-foreground"
            >
              <MonitorPlay className="size-4 text-primary" />
              {formation.format}
            </div>
          </div>
          <div
            class="rounded-2xl border border-primary/12 bg-primary/5 px-4 py-3"
          >
            <p
              class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground"
            >
              Public
            </p>
            <div
              class="mt-2 flex items-center gap-2 text-sm font-medium text-foreground"
            >
              <Users className="size-4 text-primary" />
              {formation.audience}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Sticky tab bar ── -->
  <div
    id="tab-bar"
    class="sticky top-0 z-40 border-b border-border/60 bg-white/95 backdrop-blur-md"
  >
    <div class="container">
      <div class="flex items-center gap-1 overflow-x-auto py-0 scrollbar-none">
        {
          tabs.map((tab) => (
            <a
              href={tab.href}
              data-tab={tab.href}
              class="tab-link shrink-0 border-b-2 border-transparent px-4 py-3.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
            >
              {tab.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ── Body ── -->
  <div class="bg-muted/30">
    <div class="container py-12 sm:py-16">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
        <!-- ── Content column ── -->
        <div class="min-w-0 space-y-10">
          <!-- Description -->
          <section
            id="description"
            class="scroll-mt-20 rounded-2xl border border-border/70 bg-white p-6 sm:p-8"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex size-9 items-center justify-center rounded-xl bg-primary/10"
              >
                <BookOpen className="size-4.5 text-primary" />
              </div>
              <h2 class="text-xl font-semibold text-foreground">
                Description de la formation
              </h2>
            </div>
            <div class="mt-1 ml-12 h-px bg-border/60"></div>

            <p class="mt-5 text-base leading-8 text-muted-foreground">
              {formation.description}
            </p>
          </section>

          <!-- Objectifs -->
          {
            formation.objectif || formation.pointsCles.length > 0 ? (
              <section
                id="objectifs"
                class="scroll-mt-20 rounded-2xl border border-border/70 bg-white p-6 sm:p-8"
              >
                <div class="flex items-center gap-3">
                  <div class="flex size-9 items-center justify-center rounded-xl bg-primary/10">
                    <Target className="size-4.5 text-primary" />
                  </div>
                  <h2 class="text-xl font-semibold text-foreground">
                    Objectifs pédagogiques
                  </h2>
                </div>
                <div class="mt-1 ml-12 h-px bg-border/60" />

                {formation.objectif ? (
                  <p class="mt-5 text-base leading-8 text-muted-foreground">
                    {formation.objectif}
                  </p>
                ) : null}

                {formation.pointsCles.length > 0 ? (
                  <ul class="mt-5 space-y-3">
                    {formation.pointsCles.map((point) => (
                      <li class="flex items-start gap-3 text-base leading-7 text-foreground/80">
                        <span class="mt-2 flex size-2 shrink-0 rounded-full bg-[#FF9800]" />
                        {point}
                      </li>
                    ))}
                  </ul>
                ) : null}
              </section>
            ) : null
          }

          <!-- Programme -->
          {
            formation.programme.length > 0 ? (
              <section
                id="programme"
                class="scroll-mt-20 rounded-2xl border border-border/70 bg-white p-6 sm:p-8"
              >
                <div class="flex items-center gap-3">
                  <div class="flex size-9 items-center justify-center rounded-xl bg-primary/10">
                    <GraduationCap className="size-4.5 text-primary" />
                  </div>
                  <h2 class="text-xl font-semibold text-foreground">
                    Programme de la formation
                  </h2>
                </div>
                <div class="mt-1 ml-12 h-px bg-border/60" />

                <div class="mt-6 space-y-4">
                  {formation.programme.map((module, i) => (
                    <div class="overflow-hidden rounded-xl border border-border/60 bg-muted/20">
                      <div class="flex items-center gap-3 border-b border-border/50 bg-primary/5 px-5 py-3.5">
                        <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-primary-foreground">
                          {String(i + 1).padStart(2, "0")}
                        </span>
                        <h3 class="text-sm font-semibold text-foreground sm:text-base">
                          {module.title}
                        </h3>
                      </div>
                      {module.items.length > 0 ? (
                        <ul class="space-y-0 p-5">
                          {module.items.map((item) => (
                            <li class="flex items-start gap-3 border-b border-border/40 py-2.5 text-sm leading-6 text-muted-foreground last:border-0 last:pb-0">
                              <span class="mt-2 flex size-1.5 shrink-0 rounded-full bg-[#FF9800]/60" />
                              {item}
                            </li>
                          ))}
                        </ul>
                      ) : null}
                    </div>
                  ))}
                </div>
              </section>
            ) : null
          }

          <!-- Public cible -->
          <section
            id="public"
            class="scroll-mt-20 rounded-2xl border border-border/70 bg-white p-6 sm:p-8"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex size-9 items-center justify-center rounded-xl bg-primary/10"
              >
                <Users className="size-4.5 text-primary" />
              </div>
              <h2 class="text-xl font-semibold text-foreground">
                Public cible
              </h2>
            </div>
            <div class="mt-1 ml-12 h-px bg-border/60"></div>
            <div
              class="mt-5 rounded-2xl border border-primary/12 bg-primary/5 p-5"
            >
              <p
                class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground"
              >
                Public visé
              </p>
              <p class="mt-2 text-base font-medium text-foreground">
                {formation.audience}
              </p>
              <p class="mt-3 text-sm leading-6 text-muted-foreground">
                Le contenu et le rythme sont ajustés au niveau des participants
                et aux contraintes concrètes de l’établissement.
              </p>
            </div>
          </section>

          <!-- Modalités -->
          {
            formation.methodesPedagogiques.length > 0 ||
            formation.modalitesEvaluation.length > 0 ? (
              <section
                id="modalites"
                class="scroll-mt-20 rounded-2xl border border-border/70 bg-white p-6 sm:p-8"
              >
                <div class="flex items-center gap-3">
                  <div class="flex size-9 items-center justify-center rounded-xl bg-primary/10">
                    <Settings className="size-4.5 text-primary" />
                  </div>
                  <h2 class="text-xl font-semibold text-foreground">
                    Modalités
                  </h2>
                </div>
                <div class="mt-1 ml-12 h-px bg-border/60" />
                <div class="mt-5 grid gap-4 sm:grid-cols-2">
                  {formation.methodesPedagogiques.length > 0 ? (
                    <div class="rounded-xl border border-border/60 bg-muted/40 p-5">
                      <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">
                        Méthodes pédagogiques
                      </p>
                      <ul class="mt-3 space-y-2">
                        {formation.methodesPedagogiques.map((item) => (
                          <li class="flex items-start gap-2.5 text-sm leading-6 text-muted-foreground">
                            <span class="mt-2 flex size-1.5 shrink-0 rounded-full bg-[#FF9800]/70" />
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ) : null}
                  {formation.modalitesEvaluation.length > 0 ? (
                    <div class="rounded-xl border border-border/60 bg-muted/40 p-5">
                      <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">
                        Modalités d'évaluation
                      </p>
                      <ul class="mt-3 space-y-2">
                        {formation.modalitesEvaluation.map((item) => (
                          <li class="flex items-start gap-2.5 text-sm leading-6 text-muted-foreground">
                            <span class="mt-2 flex size-1.5 shrink-0 rounded-full bg-[#FF9800]/70" />
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ) : null}
                </div>
              </section>
            ) : null
          }

          <!-- Prérequis -->
          {
            formation.prerequisTechniques.length > 0 ? (
              <section
                id="prerequis"
                class="scroll-mt-20 rounded-2xl border border-border/70 bg-white p-6 sm:p-8"
              >
                <div class="flex items-center gap-3">
                  <div class="flex size-9 items-center justify-center rounded-xl bg-primary/10">
                    <Wrench className="size-4.5 text-primary" />
                  </div>
                  <h2 class="text-xl font-semibold text-foreground">
                    Prérequis
                  </h2>
                </div>
                <div class="mt-1 ml-12 h-px bg-border/60" />
                <ul class="mt-5 space-y-2.5">
                  {formation.prerequisTechniques.map((item) => (
                    <li class="flex items-start gap-3 text-sm leading-7 text-muted-foreground">
                      <span class="mt-2.5 flex size-1.5 shrink-0 rounded-full bg-[#FF9800]/70" />
                      {item}
                    </li>
                  ))}
                </ul>
              </section>
            ) : null
          }
        </div>

        <!-- ── Sticky sidebar ── -->
        <aside class="hidden lg:block">
          <div class="sticky top-20">
            <!-- CTA card -->
            <div
              class="rounded-2xl border border-border/70 bg-white p-6 shadow-sm"
            >
              {
                formation.priceMeta ? (
                  <div class="mb-4 rounded-xl bg-muted/70 px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">
                      Prochaine session
                    </p>
                    <p class="mt-1 text-sm font-medium text-foreground">
                      {formation.priceMeta}
                    </p>
                  </div>
                ) : null
              }

              <p
                class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground"
              >
                Tarif indicatif
              </p>
              <p
                class="mt-1.5 text-[2.4rem] font-bold leading-none text-foreground"
              >
                {formation.price ?? "Sur devis"}
              </p>

              <div class="mt-5 flex flex-col gap-2.5">
                <a
                  href={formation.primaryCtaHref ?? "/contact"}
                  class="flex h-11 w-full items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
                >
                  {formation.primaryCtaLabel ?? "Demander un devis"}
                </a>
                <Button
                  asChild
                  variant="outline"
                  className="h-11 w-full rounded-full"
                >
                  <a href={formation.secondaryCtaHref ?? "/contact"}>
                    {formation.secondaryCtaLabel ?? "Planifier un échange"}
                  </a>
                </Button>
              </div>

              <p
                class="mt-5 border-t border-border/60 pt-5 text-sm leading-6 text-muted-foreground"
              >
                Intervention sur mesure, en présentiel ou à distance, selon
                votre organisation.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</DefaultLayout>

<!-- Tab bar active state on scroll -->
<script>
  const sections = document.querySelectorAll<HTMLElement>("section[id]");
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-tab]");

  function setActive(id: string) {
    links.forEach((link) => {
      const isActive = link.dataset.tab === `#${id}`;
      link.classList.toggle("border-primary", isActive);
      link.classList.toggle("text-primary", isActive);
      link.classList.toggle("border-transparent", !isActive);
      link.classList.toggle("text-muted-foreground", !isActive);
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
          break;
        }
      }
    },
    { rootMargin: "-30% 0px -60% 0px" },
  );

  sections.forEach((s) => observer.observe(s));
</script>
